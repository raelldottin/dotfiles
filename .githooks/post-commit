#!/usr/bin/env bash
set -euo pipefail

current_version="$(
  python3 - <<'PY'
from pathlib import Path

from gitvars import resolve_current_version

print(resolve_current_version(Path.cwd()))
PY
)"
git config current.version "$current_version"

if command -v tree >/dev/null 2>&1; then
  git config current.filehierarchy "$(tree -a --gitignore)"
fi
