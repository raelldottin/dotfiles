#!/usr/bin/env bash
set -euo pipefail

# https://www.viget.com/articles/two-ways-to-share-git-hooks-with-your-team/
# git config core.hooksPath .githooks

maybe_capture_command() {
  local output_path="$1"
  shift

  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Skipping $1 snapshot because the command is not installed."
    return 0
  fi

  "$@" >"$output_path"
}

# run from the root of the repo
python3 .githooks/replace_by_git_vars.py README.template README.md
maybe_capture_command homebrew_installed_app.txt brew list
maybe_capture_command npm_installed_app.txt npm list -g

