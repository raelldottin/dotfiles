#!/usr/bin/env python3
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
import workstation

if __name__ == "__main__":
    upstream = sys.argv[1]
    branch = sys.argv[2] if len(sys.argv) > 2 else "HEAD"
    sys.argv = [sys.argv[0], "guard", "--rebase-upstream=" + upstream, "--rebase-branch=" + branch]
    raise SystemExit(workstation.main())
